{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAE-BMAD Missing Implementation Register Schema",
  "type": "object",
  "required": [
    "artifact_id",
    "status",
    "generated_date",
    "total_gaps_identified",
    "gap_items",
    "remediation_roadmap"
  ],
  "properties": {
    "artifact_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "IN_REVIEW", "APPROVED", "SUPERSEDED"]
    },
    "generated_date": { "type": "string" },
    "total_gaps_identified": { "type": "integer", "minimum": 3 },
    "gap_items": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "gap_id",
          "title",
          "operating_level",
          "severity",
          "missing_capability_description",
          "blocking_status",
          "remediation_plan"
        ],
        "properties": {
          "gap_id": { "type": "string", "pattern": "^GAP-[0-9]{3}$" },
          "title": { "type": "string" },
          "operating_level": { "type": "string" },
          "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "missing_capability_description": { "type": "string" },
          "blocking_status": { "type": "boolean" },
          "remediation_plan": { "type": "string", "minLength": 10 }
        }
      }
    },
    "remediation_roadmap": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  }
}
