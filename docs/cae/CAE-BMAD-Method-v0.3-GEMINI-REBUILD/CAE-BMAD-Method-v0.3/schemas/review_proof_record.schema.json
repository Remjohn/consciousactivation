{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAE-BMAD Review and Gate Record Schema",
  "type": "object",
  "required": [
    "artifact_id",
    "status",
    "generated_date",
    "audited_mandates",
    "countertest_evaluations",
    "false_proof_checks",
    "gate_clearance_verdict",
    "rollback_procedures"
  ],
  "properties": {
    "artifact_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "IN_REVIEW", "APPROVED", "SUPERSEDED"]
    },
    "generated_date": { "type": "string" },
    "audited_mandates": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string" }
    },
    "countertest_evaluations": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "countertest_id",
          "mandate_id",
          "target_behavior",
          "failure_mode_tested",
          "verdict"
        ],
        "properties": {
          "countertest_id": { "type": "string" },
          "mandate_id": { "type": "string" },
          "target_behavior": { "type": "string" },
          "failure_mode_tested": { "type": "string" },
          "verdict": { "type": "string", "enum": ["COUNTERTEST_PASSED", "COUNTERTEST_FAILED"] }
        }
      }
    },
    "false_proof_checks": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["check_name", "assertion", "passed", "evidence"],
        "properties": {
          "check_name": { "type": "string" },
          "assertion": { "type": "string" },
          "passed": { "type": "boolean" },
          "evidence": { "type": "string" }
        }
      }
    },
    "gate_clearance_verdict": {
      "type": "string",
      "enum": ["CLEARANCE_GRANTED", "CLEARANCE_WITHHELD", "CONDITIONAL_APPROVAL"]
    },
    "rollback_procedures": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  }
}
