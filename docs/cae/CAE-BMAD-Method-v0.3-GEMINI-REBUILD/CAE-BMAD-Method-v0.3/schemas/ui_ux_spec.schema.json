{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAE-BMAD UI/UX Specification Schema",
  "type": "object",
  "required": [
    "artifact_id",
    "status",
    "product_name",
    "operator_views",
    "atomic_harness_tokens",
    "interaction_flows",
    "accessibility_standards"
  ],
  "properties": {
    "artifact_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "IN_REVIEW", "APPROVED", "SUPERSEDED"]
    },
    "product_name": { "type": "string" },
    "operator_views": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["view_id", "title", "purpose", "primary_components"],
        "properties": {
          "view_id": { "type": "string" },
          "title": { "type": "string" },
          "purpose": { "type": "string" },
          "primary_components": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "atomic_harness_tokens": {
      "type": "object",
      "required": ["color_tokens", "typography_tokens", "telemetry_monitors"],
      "properties": {
        "color_tokens": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "typography_tokens": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "telemetry_monitors": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "interaction_flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["flow_name", "trigger", "steps", "error_handling"],
        "properties": {
          "flow_name": { "type": "string" },
          "trigger": { "type": "string" },
          "steps": { "type": "array", "items": { "type": "string" } },
          "error_handling": { "type": "string" }
        }
      }
    },
    "accessibility_standards": { "type": "string" }
  }
}
