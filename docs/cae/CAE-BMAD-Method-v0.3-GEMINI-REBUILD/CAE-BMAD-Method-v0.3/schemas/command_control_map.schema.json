{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAE-BMAD Command and Control Map Schema",
  "type": "object",
  "required": [
    "artifact_id",
    "status",
    "generated_date",
    "total_commands",
    "command_suites",
    "cli_entrypoints",
    "execution_test_summary"
  ],
  "properties": {
    "artifact_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "IN_REVIEW", "APPROVED", "SUPERSEDED"]
    },
    "generated_date": { "type": "string" },
    "total_commands": { "type": "integer", "minimum": 5 },
    "command_suites": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["suite_id", "name", "script_path", "runtime_engine", "description", "verified_executable"],
        "properties": {
          "suite_id": { "type": "string" },
          "name": { "type": "string" },
          "script_path": { "type": "string" },
          "runtime_engine": { "type": "string", "enum": ["PYTHON", "BASH", "POWERSHELL", "NODE"] },
          "description": { "type": "string" },
          "verified_executable": { "type": "boolean" }
        }
      }
    },
    "cli_entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command_name", "target_function", "package"],
        "properties": {
          "command_name": { "type": "string" },
          "target_function": { "type": "string" },
          "package": { "type": "string" }
        }
      }
    },
    "execution_test_summary": { "type": "string" }
  }
}
