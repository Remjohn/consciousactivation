{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAE-BMAD Module Map Schema",
  "type": "object",
  "required": [
    "artifact_id",
    "status",
    "generated_date",
    "total_modules",
    "modules",
    "dependency_graph_summary",
    "circular_dependencies_detected"
  ],
  "properties": {
    "artifact_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "IN_REVIEW", "APPROVED", "SUPERSEDED"]
    },
    "generated_date": { "type": "string" },
    "total_modules": { "type": "integer", "minimum": 4 },
    "modules": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["module_namespace", "root_directory", "public_symbols", "internal_dependencies", "status"],
        "properties": {
          "module_namespace": { "type": "string" },
          "root_directory": { "type": "string" },
          "public_symbols": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "internal_dependencies": {
            "type": "array",
            "items": { "type": "string" }
          },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "INHERITED", "MIGRATING", "STABLE"]
          }
        }
      }
    },
    "dependency_graph_summary": { "type": "string" },
    "circular_dependencies_detected": { "type": "boolean" }
  }
}
