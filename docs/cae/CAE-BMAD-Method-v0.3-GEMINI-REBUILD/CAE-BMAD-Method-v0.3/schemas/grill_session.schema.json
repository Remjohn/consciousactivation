{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAE-BMAD Grill-Me Session Schema",
  "type": "object",
  "required": [
    "session_id",
    "topic",
    "active_question_number",
    "code_precheck",
    "question",
    "recommended_answer",
    "word_count",
    "collision_primitive",
    "anti_genericity_evaluations",
    "status"
  ],
  "properties": {
    "session_id": { "type": "string" },
    "topic": { "type": "string" },
    "active_question_number": { "type": "integer", "minimum": 1 },
    "code_precheck": {
      "type": "object",
      "required": ["inspected_surfaces", "why_unresolvable_by_code"],
      "properties": {
        "inspected_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "why_unresolvable_by_code": { "type": "string", "minLength": 20 }
      }
    },
    "question": {
      "type": "string",
      "minLength": 15
    },
    "recommended_answer": {
      "type": "string",
      "minLength": 1200
    },
    "word_count": {
      "type": "integer",
      "minimum": 320
    },
    "collision_primitive": {
      "type": "string",
      "enum": ["PREDICTION_VIOLATION", "COSTLY_EXPOSURE", "LATENT_PATTERN_ARTICULATION"]
    },
    "anti_genericity_evaluations": {
      "type": "object",
      "required": ["passed_check_1", "passed_check_2", "passed_check_3", "passed_check_4"],
      "properties": {
        "passed_check_1": { "type": "boolean", "const": true },
        "passed_check_2": { "type": "boolean", "const": true },
        "passed_check_3": { "type": "boolean", "const": true },
        "passed_check_4": { "type": "boolean", "const": true }
      }
    },
    "status": {
      "type": "string",
      "enum": ["PENDING_OPERATOR_RESPONSE", "RATIFIED", "REJECTED", "MODIFIED"]
    },
    "operator_decision": {
      "type": "string"
    }
  }
}
