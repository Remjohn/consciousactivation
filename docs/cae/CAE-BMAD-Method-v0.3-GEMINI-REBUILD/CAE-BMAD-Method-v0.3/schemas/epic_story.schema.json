{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAE-BMAD Epic/Story Schema",
  "type": "object",
  "required": [
    "epic_id",
    "title",
    "status",
    "prd_modules",
    "functional_requirements",
    "stories"
  ],
  "properties": {
    "epic_id": {
      "type": "string",
      "pattern": "^EPIC-[0-9]{3}$"
    },
    "title": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["BACKLOG", "IN_PROGRESS", "BLOCKED", "DONE", "SUPERSEDED"]
    },
    "prd_modules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^PRD-[0-9]{3}$" }
    },
    "functional_requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^FR-[0-9]{3}$" }
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["story_id", "as_a", "i_want", "so_that", "acceptance_criteria"],
        "properties": {
          "story_id": { "type": "string", "pattern": "^STORY-[0-9]{4}$" },
          "as_a": { "type": "string" },
          "i_want": { "type": "string" },
          "so_that": { "type": "string" },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
