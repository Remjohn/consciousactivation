{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAE-BMAD Agent System Architecture Schema",
  "type": "object",
  "required": [
    "artifact_id",
    "status",
    "generated_date",
    "total_agents",
    "agents",
    "boundary_rules",
    "communication_matrix"
  ],
  "properties": {
    "artifact_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "IN_REVIEW", "APPROVED", "SUPERSEDED"]
    },
    "generated_date": { "type": "string" },
    "total_agents": { "type": "integer", "minimum": 19 },
    "agents": {
      "type": "array",
      "minItems": 19,
      "items": {
        "type": "object",
        "required": [
          "agent_id",
          "name",
          "primary_operating_level",
          "assigned_skills",
          "input_contract",
          "output_contract",
          "boundary_statement"
        ],
        "properties": {
          "agent_id": { "type": "string", "pattern": "^cae-[a-z0-9-]+$" },
          "name": { "type": "string" },
          "primary_operating_level": { "type": "string" },
          "assigned_skills": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "input_contract": {
            "type": "array",
            "items": { "type": "string" }
          },
          "output_contract": {
            "type": "array",
            "items": { "type": "string" }
          },
          "boundary_statement": { "type": "string", "minLength": 10 }
        }
      }
    },
    "boundary_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "communication_matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_agent", "target_agent", "protocol", "validation_contract"],
        "properties": {
          "source_agent": { "type": "string" },
          "target_agent": { "type": "string" },
          "protocol": { "type": "string" },
          "validation_contract": { "type": "string" }
        }
      }
    }
  }
}
