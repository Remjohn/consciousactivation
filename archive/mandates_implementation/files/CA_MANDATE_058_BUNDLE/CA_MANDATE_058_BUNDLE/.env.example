# ============================================================
# CAE Environment Variables — copy to .env and fill real values
# .env is listed in .gitignore and must never be committed
# ============================================================

# Supabase session-pooler connection URL (required).
# The API container will refuse to start without this value.
# Format: postgresql://postgres.<project_ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
# Obtain from: Supabase Dashboard → Project Settings → Database → Connection string → Session pooler
CAE_SUPABASE_DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
