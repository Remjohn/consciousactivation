+        "timeout_seconds": 3.0
+      },
+      "authority_boundary": "downstream_runtime_only"
+    },
+    {
+      "id": "sam3",
+      "display_name": "SAM3",
+      "enabled_default": false,
+      "enabled_env": "CAE_SAM3_ENABLED",
+      "required": false,
+      "capabilities": [
+        "subject_tracking",
+        "segmentation_geometry"
+      ],
+      "route_prefix": "/runtime/sam3",
+      "command_env": "CAE_SAM3_COMMAND",
+      "target_url_env": "CAE_SAM3_URL",
+      "health": {
+        "kind": "http",
+        "url_env": "CAE_SAM3_HEALTH_URL",
+        "expected_status": 200,
+        "timeout_seconds": 5.0
+      },
+      "authority_boundary": "downstream_runtime_only",
+      "notes": [
+        "SAM3 output is bounded to geometry/tracking support; it does not own semantic identity."
+      ]
