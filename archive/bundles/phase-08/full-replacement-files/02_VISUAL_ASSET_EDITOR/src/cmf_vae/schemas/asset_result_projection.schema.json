{
  "$id": "https://contracts.conscious-activations.dev/vae/asset_result_projection/1.0.0/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_ref": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "canonical_ref": {
          "minLength": 1,
          "type": "string"
        },
        "payload_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "resource_id": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "resource_id",
        "version",
        "payload_hash",
        "canonical_ref"
      ],
      "title": "Resource reference",
      "type": "object"
    },
    "completion_status": {
      "minLength": 1,
      "type": "string"
    },
    "consumption_authority_owned_by_vae": {
      "type": "boolean"
    },
    "demand": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "canonical_ref": {
          "minLength": 1,
          "type": "string"
        },
        "payload_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "request_id",
        "version",
        "payload_hash",
        "canonical_ref"
      ],
      "title": "Demand identity",
      "type": "object"
    },
    "production_acceptance_owned_by_vae": {
      "type": "boolean"
    },
    "result_id": {
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "result_id",
    "version",
    "demand",
    "artifact_ref",
    "completion_status",
    "production_acceptance_owned_by_vae",
    "consumption_authority_owned_by_vae"
  ],
  "title": "Asset Result Projection",
  "type": "object"
}
