{
  "$id": "https://contracts.conscious-activations.dev/vae/control_tower_projection/1.0.0/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "certified": {
      "type": "boolean"
    },
    "demand_ref": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "canonical_ref": {
          "minLength": 1,
          "type": "string"
        },
        "payload_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "request_id",
        "version",
        "payload_hash",
        "canonical_ref"
      ],
      "title": "Demand identity",
      "type": "object"
    },
    "evaluation_ref": {
      "oneOf": [
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "object_id": {
              "minLength": 1,
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "version": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "object_id",
            "version",
            "sha256"
          ],
          "title": "Immutable reference",
          "type": "object"
        },
        {
          "type": "string"
        }
      ]
    },
    "event_count": {
      "minimum": 0,
      "type": "integer"
    },
    "job": {
      "type": "object"
    },
    "latest_event": {
      "minLength": 1,
      "type": "string"
    },
    "plan_ref": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "version",
        "sha256"
      ],
      "title": "Immutable reference",
      "type": "object"
    },
    "production_authorized": {
      "type": "boolean"
    },
    "projection_id": {
      "minLength": 1,
      "type": "string"
    },
    "projection_state": {
      "minLength": 1,
      "type": "string"
    },
    "projection_version": {
      "minLength": 1,
      "type": "string"
    },
    "result_ref": {
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "string"
        }
      ]
    },
    "workcell_ref": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "version",
        "sha256"
      ],
      "title": "Immutable reference",
      "type": "object"
    }
  },
  "required": [
    "projection_id",
    "projection_version",
    "projection_state",
    "demand_ref",
    "plan_ref",
    "workcell_ref",
    "job",
    "event_count",
    "latest_event",
    "evaluation_ref",
    "result_ref",
    "production_authorized",
    "certified"
  ],
  "title": "VAE Control Tower Projection",
  "type": "object"
}
