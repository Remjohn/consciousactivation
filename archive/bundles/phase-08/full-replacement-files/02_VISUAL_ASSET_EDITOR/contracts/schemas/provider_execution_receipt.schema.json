{
  "$id": "https://contracts.conscious-activations.dev/vae/provider_execution_receipt/1.0.0/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capability_id": {
      "minLength": 1,
      "type": "string"
    },
    "executed": {
      "type": "boolean"
    },
    "production_authorized": {
      "type": "boolean"
    },
    "provider_id": {
      "minLength": 1,
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "result_refs": {
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "canonical_ref": {
            "minLength": 1,
            "type": "string"
          },
          "payload_hash": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "resource_id": {
            "minLength": 1,
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "resource_id",
          "version",
          "payload_hash",
          "canonical_ref"
        ],
        "title": "Resource reference",
        "type": "object"
      },
      "type": "array"
    },
    "runtime_ref": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "version",
        "sha256"
      ],
      "title": "Immutable reference",
      "type": "object"
    }
  },
  "required": [
    "provider_id",
    "capability_id",
    "executed",
    "request_sha256",
    "result_refs",
    "runtime_ref",
    "production_authorized"
  ],
  "title": "Provider Execution Receipt",
  "type": "object"
}
