  "additionalProperties": false,
  "properties": {
    "canonical_state": {
      "type": "boolean"
    },
    "document_id": {
      "minLength": 1,
      "type": "string"
    },
    "frontmatter": {
      "type": "object"
    },
    "markdown": {
      "minLength": 1,
      "type": "string"
    },
    "markdown_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "rebuildable": {
      "type": "boolean"
    }
  },
  "required": [
    "document_id",
    "frontmatter",
    "markdown_sha256",
    "canonical_state",
    "rebuildable",
    "markdown"
  ],
  "title": "OKF Projection",
  "type": "object"
}
