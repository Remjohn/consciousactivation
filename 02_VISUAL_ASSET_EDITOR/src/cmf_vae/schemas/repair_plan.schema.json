{
  "$id": "https://contracts.conscious-activations.dev/vae/repair_plan/1.0.0/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "minLength": 1,
      "type": "string"
    },
    "attempt_number": {
      "minimum": 1,
      "type": "integer"
    },
    "descendant_only": {
      "type": "boolean"
    },
    "escalation_required": {
      "type": "boolean"
    },
    "evidence_refs": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "failure_code": {
      "minLength": 1,
      "type": "string"
    },
    "global_regeneration_allowed": {
      "type": "boolean"
    },
    "maximum_attempts": {
      "minimum": 1,
      "type": "integer"
    },
    "preserved_properties": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "quality_threshold_lowering_allowed": {
      "type": "boolean"
    },
    "repair_plan_id": {
      "minLength": 1,
      "type": "string"
    },
    "repair_plan_version": {
      "minLength": 1,
      "type": "string"
    },
    "responsible_product": {
      "minLength": 1,
      "type": "string"
    },
    "semantic_mutation_allowed": {
      "type": "boolean"
    },
    "target_ref": {
      "type": "object"
    }
  },
  "required": [
    "repair_plan_id",
    "repair_plan_version",
    "target_ref",
    "failure_code",
    "evidence_refs",
    "action",
    "responsible_product",
    "attempt_number",
    "maximum_attempts",
    "preserved_properties",
    "descendant_only",
    "quality_threshold_lowering_allowed",
    "semantic_mutation_allowed",
    "global_regeneration_allowed",
    "escalation_required"
  ],
  "title": "Bounded Repair Plan",
  "type": "object"
}
