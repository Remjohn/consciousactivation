      },
      "required": [
        "object_id",
        "version",
        "sha256"
      ],
      "type": "object"
    },
    "permitted_action_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "projection_id": {
      "minLength": 1,
      "type": "string"
    },
    "reaction_receipt_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "object_id",
          "version",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "relationship_edges": {
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "relation_type": {
            "minLength": 1,
            "type": "string"
          },
          "target_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "relation_type",
          "target_id"
        ],
        "title": "RelationshipEdge",
        "type": "object"
      },
      "type": "array"
