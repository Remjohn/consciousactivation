  "additionalProperties": false,
  "properties": {
    "authority_state": {
      "minLength": 1,
      "type": "string"
    },
    "category_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "contradicts_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "evidence_quality_micros": {
      "minimum": 0,
      "type": "integer"
    },
    "evidence_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "object_id",
          "version",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "expression_moment_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "object_id",
          "version",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "failed_alternative": {
      "type": "boolean"
    },
    "format_profile_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "lifecycle_state": {
      "minLength": 1,
      "type": "string"
    },
    "object_ref": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
