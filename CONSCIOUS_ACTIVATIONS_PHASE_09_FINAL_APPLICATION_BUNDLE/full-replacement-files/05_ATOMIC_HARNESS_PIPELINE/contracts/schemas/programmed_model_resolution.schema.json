{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claim_ref": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "object_id": {
              "minLength": 1,
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "version": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "object_id",
            "version",
            "sha256"
          ],
          "type": "object"
        },
        {
          "enum": [
            "NOT_APPLICABLE"
          ],
          "type": "string"
        }
      ]
    },
    "decision": {
      "minLength": 1,
      "type": "string"
    },
    "fallback_mode": {
      "minLength": 1,
      "type": "string"
    },
    "model_artifact_ref": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "object_id": {
              "minLength": 1,
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "version": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "object_id",
            "version",
            "sha256"
          ],
          "type": "object"
        },
        {
          "enum": [
            "NOT_APPLICABLE"
          ],
          "type": "string"
        }
      ]
    },
    "model_program_ref": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "object_id": {
              "minLength": 1,
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "version": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "object_id",
            "version",
            "sha256"
          ],
          "type": "object"
        },
        {
          "enum": [
            "NOT_APPLICABLE"
          ],
          "type": "string"
        }
      ]
    },
    "production_authorized": {
      "type": "boolean"
    },
    "request_id": {
      "minLength": 1,
      "type": "string"
    },
    "resolution_id": {
      "minLength": 1,
      "type": "string"
    },
    "resolution_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "resolution_id",
    "request_id",
    "decision",
    "model_program_ref",
    "claim_ref",
    "model_artifact_ref",
    "fallback_mode",
    "production_authorized",
    "resolution_sha256"
  ],
  "title": "ProgrammedModelResolution",
  "type": "object"
}
