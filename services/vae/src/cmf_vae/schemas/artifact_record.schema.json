{
  "$id": "https://contracts.conscious-activations.dev/vae/artifact_record/1.0.0/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "type": "string"
    },
    "artifact_version": {
      "minLength": 1,
      "type": "string"
    },
    "byte_count": {
      "minimum": 0,
      "type": "integer"
    },
    "created_at_utc": {
      "minLength": 1,
      "type": "string"
    },
    "logical_uri": {
      "minLength": 1,
      "type": "string"
    },
    "media_type": {
      "minLength": 1,
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "resource_ref": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "canonical_ref": {
          "minLength": 1,
          "type": "string"
        },
        "payload_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "resource_id": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "resource_id",
        "version",
        "payload_hash",
        "canonical_ref"
      ],
      "title": "Resource reference",
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "artifact_version",
    "sha256",
    "byte_count",
    "media_type",
    "logical_uri",
    "metadata",
    "created_at_utc",
    "resource_ref"
  ],
  "title": "Artifact Record",
  "type": "object"
}
