{
  "$id": "https://contracts.conscious-activations.dev/vae/visual_production_plan/1.0.0/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activation_contract": {
      "type": "object"
    },
    "asset_family": {
      "minLength": 1,
      "type": "string"
    },
    "asset_subtype": {
      "minLength": 1,
      "type": "string"
    },
    "category_profile_ref": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "canonical_ref": {
          "minLength": 1,
          "type": "string"
        },
        "payload_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "resource_id": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "resource_id",
        "version",
        "payload_hash",
        "canonical_ref"
      ],
      "title": "Resource reference",
      "type": "object"
    },
    "composition_intent": {
      "type": "object"
    },
    "delivery": {
      "type": "object"
    },
    "demand_ref": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "canonical_ref": {
          "minLength": 1,
          "type": "string"
        },
        "payload_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "request_id",
        "version",
        "payload_hash",
        "canonical_ref"
      ],
      "title": "Demand identity",
      "type": "object"
    },
    "evaluation_policy": {
      "type": "object"
    },
    "execution_policy": {
      "type": "object"
    },
    "feature_contracts": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "format_profile_ref": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "canonical_ref": {
          "minLength": 1,
          "type": "string"
        },
        "payload_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "resource_id": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "resource_id",
        "version",
        "payload_hash",
        "canonical_ref"
      ],
      "title": "Resource reference",
      "type": "object"
    },
    "plan_id": {
      "minLength": 1,
      "type": "string"
    },
    "plan_version": {
      "minLength": 1,
      "type": "string"
    },
    "production_authorized": {
      "type": "boolean"
    },
    "provider_bindings": {
      "minLength": 1,
      "type": "string"
    },
    "semantic_lineage": {
      "type": "object"
    },
    "semantic_values_owned_by_vae": {
      "type": "boolean"
    },
    "source_provenance": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "source_kind": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "source_kind"
      ],
      "title": "Contract",
      "type": "object"
    },
    "stages": {
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "inputs": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "outputs": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "quality_round": {
            "minimum": 0,
            "type": "integer"
          },
          "required_capability_kind": {
            "minLength": 1,
            "type": "string"
          },
          "required_features": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "sequence": {
            "minimum": 0,
            "type": "integer"
          },
          "stage_id": {
            "minLength": 1,
            "type": "string"
          },
          "stage_kind": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "stage_id",
          "sequence",
          "stage_kind",
          "required_capability_kind",
          "required_features",
          "inputs",
          "outputs",
          "quality_round"
        ],
        "title": "Contract",
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "visual_narrative_program": {
      "type": "object"
    },
    "visual_semantic_pack": {
      "type": "object"
    },
    "wrong_reading_locks": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "plan_id",
    "plan_version",
    "demand_ref",
    "asset_family",
    "asset_subtype",
    "category_profile_ref",
    "format_profile_ref",
    "source_provenance",
    "semantic_lineage",
    "activation_contract",
    "visual_semantic_pack",
    "visual_narrative_program",
    "feature_contracts",
    "wrong_reading_locks",
    "composition_intent",
    "delivery",
    "evaluation_policy",
    "execution_policy",
    "stages",
    "provider_bindings",
    "semantic_values_owned_by_vae",
    "production_authorized"
  ],
  "title": "Visual Production Plan",
  "type": "object"
}
