{
  "$id": "https://contracts.conscious-activations.dev/vae/worker_registration/1.0.0/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attestation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "capability_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "state": {
      "minLength": 1,
      "type": "string"
    },
    "worker_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "worker_id",
    "capability_ids",
    "attestation_sha256",
    "state"
  ],
  "title": "Worker Registration",
  "type": "object"
}
