{
  "$id": "https://contracts.conscious-activations.dev/vae/image_conditioned_geometry_pack/1.0.0/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "face_bbox": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "height": {
          "minimum": 1,
          "type": "integer"
        },
        "width": {
          "minimum": 1,
          "type": "integer"
        },
        "x": {
          "minimum": 0,
          "type": "integer"
        },
        "y": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "Contract",
      "type": "object"
    },
    "gaze_vector": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "x_basis_points": {
          "type": "integer"
        },
        "y_basis_points": {
          "type": "integer"
        }
      },
      "required": [
        "x_basis_points",
        "y_basis_points"
      ],
      "title": "Contract",
      "type": "object"
    },
    "geometry_pack_id": {
      "minLength": 1,
      "type": "string"
    },
    "mask_ref": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "canonical_ref": {
          "minLength": 1,
          "type": "string"
        },
        "payload_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "resource_id": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "resource_id",
        "version",
        "payload_hash",
        "canonical_ref"
      ],
      "title": "Resource reference",
      "type": "object"
    },
    "negative_space_regions": {
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "height": {
            "minimum": 1,
            "type": "integer"
          },
          "width": {
            "minimum": 1,
            "type": "integer"
          },
          "x": {
            "minimum": 0,
            "type": "integer"
          },
          "y": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "title": "Contract",
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "provider_claim": {
      "minLength": 1,
      "type": "string"
    },
    "subject_bbox": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "height": {
          "minimum": 1,
          "type": "integer"
        },
        "width": {
          "minimum": 1,
          "type": "integer"
        },
        "x": {
          "minimum": 0,
          "type": "integer"
        },
        "y": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "Contract",
      "type": "object"
    }
  },
  "required": [
    "geometry_pack_id",
    "subject_bbox",
    "face_bbox",
    "gaze_vector",
    "negative_space_regions",
    "mask_ref",
    "provider_claim"
  ],
  "title": "Image Conditioned Geometry Pack",
  "type": "object"
}
