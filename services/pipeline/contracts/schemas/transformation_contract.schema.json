{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_transformation_classes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "contract_id": {
      "minLength": 1,
      "type": "string"
    },
    "evaluation_profile_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "object_id",
          "version",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "forbidden_transformations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "input_contract_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "output_contract_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "required_invariants": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "source_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "object_id",
          "version",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "contract_id",
    "version",
    "input_contract_ids",
    "output_contract_ids",
    "required_invariants",
    "allowed_transformation_classes",
    "forbidden_transformations",
    "evaluation_profile_refs",
    "source_refs"
  ],
  "title": "TransformationContract",
  "type": "object"
}
