{
  "$id": "https://conscious.activations/contracts/visual/visual_feedback_evaluation_dataset.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "visual_operator_feedback_evaluation_dataset",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "dataset_id": {"const": "visual-operator-feedback"},
    "dataset_version": {"const": "1.0.0"},
    "source_object_type": {"const": "studio_visual_feedback"},
    "record_count": {"type": "integer", "minimum": 0},
    "records": {"type": "array", "items": {"type": "object"}},
    "contrastive_examples": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "production_rules_mutated": {"const": false},
    "dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "required": [
    "dataset_id", "dataset_version", "source_object_type", "record_count",
    "records", "contrastive_examples", "production_rules_mutated", "dataset_sha256"
  ]
}
