{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_tool_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "claim_ref": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "version",
        "sha256"
      ],
      "type": "object"
    },
    "escalation_conditions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "fallback_mode": {
      "minLength": 1,
      "type": "string"
    },
    "forbidden_action_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "input_contract_id": {
      "minLength": 1,
      "type": "string"
    },
    "lifecycle_state": {
      "minLength": 1,
      "type": "string"
    },
    "model_program_id": {
      "minLength": 1,
      "type": "string"
    },
    "output_contract_id": {
      "minLength": 1,
      "type": "string"
    },
    "runtime_requirements": {
      "type": "object"
    },
    "skill_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "object_id",
          "version",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "steering_recipe_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "object_id",
          "version",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "model_program_id",
    "version",
    "claim_ref",
    "input_contract_id",
    "output_contract_id",
    "skill_refs",
    "steering_recipe_refs",
    "allowed_tool_ids",
    "forbidden_action_ids",
    "fallback_mode",
    "escalation_conditions",
    "runtime_requirements",
    "lifecycle_state"
  ],
  "title": "ProgrammedModelProgram",
  "type": "object"
}
