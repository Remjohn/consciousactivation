{
  "$id": "https://contracts.conscious-activations.dev/vae/job_record/1.0.0/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_number": {
      "minimum": 0,
      "type": "integer"
    },
    "cancellation_requested": {
      "type": "boolean"
    },
    "checkpoint": {
      "type": [
        "object",
        "null"
      ]
    },
    "created_at_utc": {
      "minLength": 1,
      "type": "string"
    },
    "failure": {
      "type": [
        "object",
        "null"
      ]
    },
    "fencing_token": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "minLength": 1,
      "type": "string"
    },
    "job_id": {
      "minLength": 1,
      "type": "string"
    },
    "lease_owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "lease_until_ms": {
      "type": [
        "integer",
        "null"
      ]
    },
    "maximum_attempts": {
      "minimum": 0,
      "type": "integer"
    },
    "request": {
      "type": "object"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "required_capabilities": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "result": {
      "type": [
        "object",
        "null"
      ]
    },
    "state": {
      "minLength": 1,
      "type": "string"
    },
    "updated_at_utc": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "idempotency_key",
    "request_sha256",
    "request",
    "required_capabilities",
    "state",
    "attempt_number",
    "maximum_attempts",
    "lease_owner",
    "fencing_token",
    "lease_until_ms",
    "cancellation_requested",
    "checkpoint",
    "result",
    "failure",
    "created_at_utc",
    "updated_at_utc"
  ],
  "title": "VAE Job Record",
  "type": "object"
}
