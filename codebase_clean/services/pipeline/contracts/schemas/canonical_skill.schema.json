{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_tool_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "authority_owner": {
      "minLength": 1,
      "type": "string"
    },
    "category_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "entry_condition_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "evaluation_profile_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "object_id",
          "version",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "forbidden_action_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "format_profile_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "invariant_locks": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "lifecycle_state": {
      "minLength": 1,
      "type": "string"
    },
    "output_contract_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "purpose": {
      "minLength": 1,
      "type": "string"
    },
    "recipe_family_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "skill_id": {
      "minLength": 1,
      "type": "string"
    },
    "source_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "object_id",
          "version",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "skill_id",
    "version",
    "title",
    "purpose",
    "authority_owner",
    "lifecycle_state",
    "category_ids",
    "format_profile_ids",
    "entry_condition_ids",
    "output_contract_ids",
    "allowed_tool_ids",
    "forbidden_action_ids",
    "invariant_locks",
    "recipe_family_ids",
    "source_refs",
    "evaluation_profile_refs"
  ],
  "title": "CanonicalSkill",
  "type": "object"
}
