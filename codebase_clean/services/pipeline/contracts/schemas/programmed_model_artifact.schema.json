    },
    "model_artifact_id": {
      "minLength": 1,
      "type": "string"
    },
    "model_family": {
      "minLength": 1,
      "type": "string"
    },
    "parameter_count": {
      "minimum": 0,
      "type": "integer"
    },
    "quantization": {
      "minLength": 1,
      "type": "string"
    },
    "runtime_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
