{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capsule_ref": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "version",
        "sha256"
      ],
      "type": "object"
    },
    "eligible_candidate_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "exclusions": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "rank_snapshot": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "receipt_id": {
      "minLength": 1,
      "type": "string"
    },
    "receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "request": {
      "type": "object"
    },
    "result": {
      "minLength": 1,
      "type": "string"
    },
    "selected_projection_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "receipt_id",
    "request",
    "eligible_candidate_ids",
    "exclusions",
    "rank_snapshot",
    "selected_projection_ids",
    "capsule_ref",
    "result",
    "receipt_sha256"
  ],
  "title": "RetrievalReceipt",
  "type": "object"
}
