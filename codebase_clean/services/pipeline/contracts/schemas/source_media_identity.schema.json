{
  "$id": "https://conscious.activations/contracts/phase6/source_media_identity.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "media_id": {"type": "string", "pattern": "^source-media:[0-9a-f]{64}$"},
    "media_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
    "media_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "byte_count": {"type": "integer", "minimum": 0},
    "authority": {"const": "SOVEREIGN_SOURCE_MEDIA_BYTES"},
    "derivative": {"const": false}
  },
  "required": [
    "media_id",
    "media_version",
    "media_sha256",
    "byte_count",
    "authority",
    "derivative"
  ],
  "title": "source_media_identity",
  "type": "object"
}
