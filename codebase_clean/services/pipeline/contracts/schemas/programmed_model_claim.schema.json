{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "applicability_envelope": {
      "type": "object"
    },
    "benchmark_ref": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "version",
        "sha256"
      ],
      "type": "object"
    },
    "claim_id": {
      "minLength": 1,
      "type": "string"
    },
    "claim_type": {
      "minLength": 1,
      "type": "string"
    },
    "evaluator_ref": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "version",
        "sha256"
      ],
      "type": "object"
    },
    "evidence_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "object_id",
          "version",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "failure_limit_micros": {
      "minimum": 0,
      "type": "integer"
    },
    "fallback_mode": {
      "minLength": 1,
      "type": "string"
    },
    "lifecycle_state": {
      "minLength": 1,
      "type": "string"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "metric_name": {
      "minLength": 1,
      "type": "string"
    },
    "model_artifact_ref": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "version",
        "sha256"
      ],
      "type": "object"
    },
    "observed_micros": {
      "minimum": 0,
      "type": "integer"
    },
    "threshold_micros": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "claim_id",
    "model_artifact_ref",
    "claim_type",
    "lifecycle_state",
    "applicability_envelope",
    "benchmark_ref",
    "evaluator_ref",
    "metric_name",
    "threshold_micros",
    "observed_micros",
    "failure_limit_micros",
    "fallback_mode",
    "limitations",
    "evidence_refs"
  ],
  "title": "ProgrammedModelClaim",
  "type": "object"
}
