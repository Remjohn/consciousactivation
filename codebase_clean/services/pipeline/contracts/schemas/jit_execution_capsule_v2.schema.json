{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_tool_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "authority_first": {
      "type": "boolean"
    },
    "capsule_id": {
      "minLength": 1,
      "type": "string"
    },
    "capsule_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "capsule_version": {
      "minLength": 1,
      "type": "string"
    },
    "coverage_proof": {
      "type": "object"
    },
    "dense_adapter_used": {
      "type": "boolean"
    },
    "encoded_bytes": {
      "minimum": 1,
      "type": "integer"
    },
    "forbidden_action_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "minimum_complete_context": {
      "type": "boolean"
    },
    "request_id": {
      "minLength": 1,
      "type": "string"
    },
    "role_id": {
      "minLength": 1,
      "type": "string"
    },
    "selected_items": {
      "items": {
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "source_package_ref": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "version",
        "sha256"
      ],
      "type": "object"
    },
    "stopping_law_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "capsule_id",
    "capsule_version",
    "request_id",
    "role_id",
    "source_package_ref",
    "selected_items",
    "coverage_proof",
    "allowed_tool_ids",
    "forbidden_action_ids",
    "stopping_law_id",
    "authority_first",
    "dense_adapter_used",
    "minimum_complete_context",
    "capsule_sha256",
    "encoded_bytes"
  ],
  "title": "JitExecutionCapsuleV2",
  "type": "object"
}
