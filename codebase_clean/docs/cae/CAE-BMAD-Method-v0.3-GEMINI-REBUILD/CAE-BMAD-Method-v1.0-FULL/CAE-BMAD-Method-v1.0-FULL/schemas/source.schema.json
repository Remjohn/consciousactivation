{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "source_id",
    "path_or_url",
    "title",
    "source_class",
    "lineage",
    "relevance",
    "authority",
    "operating_level",
    "status"
  ],
  "properties": {
    "source_id": {
      "type": "string"
    },
    "path_or_url": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "source_class": {
      "type": "string"
    },
    "lineage": {
      "type": "string"
    },
    "contributor": {
      "type": "string"
    },
    "relevance": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "authority": {
      "type": "string"
    },
    "operating_level": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "read_for": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "influenced_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}