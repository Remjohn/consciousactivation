{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAE-BMAD Operator Gate Decision Schema",
  "type": "object",
  "required": [
    "artifact_id",
    "status",
    "decisions"
  ],
  "properties": {
    "artifact_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "IN_REVIEW", "APPROVED", "SUPERSEDED"]
    },
    "decisions": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": [
          "gate_id",
          "mandate_id",
          "mandate_title",
          "status",
          "evidence_verified"
        ],
        "properties": {
          "gate_id": { "type": "string", "pattern": "^GATE-M[0-9]{2}$" },
          "mandate_id": { "type": "string", "pattern": "^M[0-9]{2}$" },
          "mandate_title": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["AWAITING_OPERATOR_RATIFICATION", "RATIFIED", "REJECTED", "ROLLBACK_TRIGGERED"]
          },
          "evidence_verified": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
